# temperature_sensor.py
# -----------------------------------
# This file handles DS18B20 temperature sensor
# -----------------------------------

import os
import glob
import time

# Load 1-Wire drivers
os.system('modprobe w1-gpio')
os.system('modprobe w1-therm')

BASE_DIR = '/sys/bus/w1/devices/'

def find_sensor():
    """Find DS18B20 sensor folder"""
    folders = glob.glob(BASE_DIR + '28-*')
    return folders[0] if folders else None

def read_temp():
    """Read temperature in Celsius"""
    folder = find_sensor()
    if not folder:
        return None
    
    device_file = folder + '/w1_slave'

    with open(device_file, 'r') as f:
        lines = f.readlines()

    # Wait until valid reading
    attempts = 0
    while lines[0].strip()[-3:] != 'YES' and attempts < 5:
        time.sleep(0.2)
        with open(device_file, 'r') as f:
            lines = f.readlines()
        attempts += 1

    if 't=' in lines[1]:
        temp_string = lines[1].split('t=')[1]
        temp_c = float(temp_string) / 1000.0
        return temp_c

    return None






    # gas_ph_sensor.py
# -----------------------------------
# Handles MCP3008 ADC, pH Sensor, MQ Gas Sensor
# -----------------------------------

import spidev

spi = spidev.SpiDev()
spi.open(0, 0)
spi.max_speed_hz = 1350000

PH_CHANNEL = 0
MQ_CHANNEL = 1

def read_adc(channel):
    """Read MCP3008 channel (0-7)"""
    adc = spi.xfer2([1, (8 + channel) << 4, 0])
    data = ((adc[1] & 3) << 8) + adc[2]
    return data

def adc_to_voltage(adc_value, vref=3.3):
    """Convert ADC value to voltage"""
    return (adc_value * vref) / 1023.0

def get_ph_status():
    adc = read_adc(PH_CHANNEL)
    voltage = adc_to_voltage(adc)

    if 0.5 <= voltage <= 3.0:
        return "Spoiled"
    elif 3.0 <= voltage <= 3.5:
        return "SPOILED"
    else:
        return "Fresh"

def get_mq_status():
    adc = read_adc(MQ_CHANNEL)
    voltage = adc_to_voltage(adc)

    if 1.0 <= voltage <= 1.5:
        return "Fresh"
    elif 2.5 <= voltage <= 3.3:
        return "Spoiled"
    else:
        return "Sensor in Air"







